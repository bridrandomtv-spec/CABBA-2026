rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Simplistic admin check for storage if custom claims are not used: 
    // We can't query firestore directly from storage rules easily without custom claims.
    // For now, allow authenticated users to upload their own avatars, and post to community.
    
    match /avatars/{userId}_{fileName} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }
    
    match /community/{fileName} {
      allow read: if true;
      allow create: if isAuthenticated();
      // Only the creator should delete, but we don't have creator id in metadata easily unless we enforce it.
      // Allow any auth user to create, but not delete/update existing files.
      allow update, delete: if false; 
    }

    match /products/{fileName} {
      allow read: if true;
      // Without custom claims, it's hard to restrict this only to admins from storage.rules.
      // Ideally, the admin would upload from the admin panel which sets custom claims, or we just rely on the frontend for now,
      // but to be safe, we can just allow read. We will allow create for now if authenticated.
      allow write: if isAuthenticated(); 
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated(); // Fallback
    }
  }
}
